<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="px-6 py-12 sm:px-12 lg:px-24 max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold tracking-tight text-base-content">
      ChatAgent
    </h1>
    <p class="mt-4 text-lg text-base-content/70">
      Connect WhatsApp and Telegram messages to local AI assistants through a pluggable adapter architecture.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title">Multi-channel inbox</h2>
          <p>
            Receive messages from WhatsApp Cloud API and Telegram Bot API over secure webhooks.
          </p>
        </div>
      </div>

      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title">Pluggable assistants</h2>
          <p>
            Route authenticated conversations to local agents such as Claude, with history kept per channel.
          </p>
        </div>
      </div>

      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title">Live dashboard</h2>
          <p>
            Watch messages arrive in real time, monitor tunnel status and manage channel callbacks.
          </p>
        </div>
      </div>

      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title">Public webhooks</h2>
          <p>
            Provider-specific webhook endpoints stay open so messages reach your app from the internet.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-10 flex gap-4">
      <.link navigate={~p"/users/log-in"} class="btn btn-primary">
        Log in
      </.link>
    </div>
  </div>
</Layouts.app>
