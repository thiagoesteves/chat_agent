# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
chat_agent-*.tar

# Dialyzer PLTs are build artifacts, cache them in CI rather than commit them.
/priv/plts/

# Assets are built from assets/ by tailwind and esbuild, so the output is not
# checked in. Run `mix assets.build` (or start the server, which watches them).
/priv/static/assets/

# Digested assets cache, written by `mix phx.digest` during assets.deploy.
/priv/static/cache_manifest.json

# In case a dependency is installed with npm rather than vendored.
/assets/node_modules/
npm-debug.log

# Local configuration overrides and individual secrets, per MIX_ENV.
config/*.override.exs

# Claude config files
claude.settings.local.json

