<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="ChatBot" suffix=" · ChatAgent" phx-no-format>{assigns[:page_title]}</.live_title>
    <%!-- Loaded ahead of the stylesheet, and not deferred, so the theme is
    applied before first paint and no wrong-theme flash is visible. --%>
    <script phx-track-static src={~p"/assets/js/theme.js"}>
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <%!-- Account actions live in the app bar, next to the theme toggle. See
    `ChatAgentWeb.Layouts.user_menu/1`. --%>
    {@inner_content}
  </body>
</html>
