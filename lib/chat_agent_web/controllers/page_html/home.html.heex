<Layouts.app flash={@flash} current_scope={@current_scope} max_width="max-w-5xl">
  <section class="text-center">
    <span class="badge badge-soft badge-primary gap-1">
      <.icon name="hero-bolt-micro" /> WhatsApp · Telegram · local agents
    </span>

    <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
      Your chats, answered by an agent you run
    </h1>

    <p class="mx-auto mt-4 max-w-2xl text-lg text-base-content/70">
      ChatAgent takes messages from WhatsApp and Telegram over webhooks, shows them arriving live,
      and hands the conversation to an assistant running on your own machine. The reply goes back
      out on the channel it came from.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <%!-- Plain hrefs: this page is a controller render, so there is no
      LiveSocket for `navigate` to make use of. --%>
      <%= if @current_scope do %>
        <.link href={~p"/channels"} class="btn btn-primary">
          Open the dashboard <.icon name="hero-arrow-long-right-micro" />
        </.link>
      <% else %>
        <.link href={~p"/users/log-in"} class="btn btn-primary">
          Log in <.icon name="hero-arrow-long-right-micro" />
        </.link>
      <% end %>

      <a href="https://github.com/thiagoesteves/chat_agent" class="btn btn-soft">
        <.icon name="hero-code-bracket-micro" /> Source
      </a>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/50">
      How a message travels
    </h2>

    <ol class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <li :for={{step, index} <- Enum.with_index(steps(), 1)} class="card bg-base-200 h-full">
        <div class="card-body gap-2">
          <span class="text-xs font-semibold text-primary">Step {index}</span>
          <h3 class="card-title text-base">{step.title}</h3>
          <p class="text-sm text-base-content/70">{step.body}</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="mt-16 grid gap-4 sm:grid-cols-2">
    <div :for={feature <- features()} class="card bg-base-200">
      <div class="card-body gap-2">
        <span class="flex size-9 items-center justify-center rounded-lg bg-primary/10 text-primary">
          <.icon name={feature.icon} class="size-5" />
        </span>
        <h3 class="card-title text-base">{feature.title}</h3>
        <p class="text-sm text-base-content/70">{feature.body}</p>
      </div>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/50">
      What is public, and what is not
    </h2>

    <div class="mt-4 overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Endpoint</th>
            <th>Access</th>
            <th>Purpose</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={route <- routes()}>
            <td><code class="text-xs">{route.path}</code></td>
            <td>
              <span class={[
                "badge badge-sm",
                if(route.public, do: "badge-ghost", else: "badge-primary")
              ]}>
                {if route.public, do: "Public", else: "Login required"}
              </span>
            </td>
            <td class="text-sm text-base-content/70">{route.purpose}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-sm text-base-content/60">
      Chat services have to reach the webhooks without a browser session, so those stay open and
      are authenticated by the provider's own signature or secret instead. The dashboard is the
      part behind a login.
    </p>
  </section>
</Layouts.app>
